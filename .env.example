# OpenRouter (https://openrouter.ai) — optional. Used by the daemon's memory
# LLM when no ANTHROPIC_API_KEY / OPENAI_API_KEY is set. Base URL is
# https://openrouter.ai/api/v1, default model anthropic/claude-opus-latest
# (override with OD_MEMORY_MODEL). Never commit a real key.
OPENROUTER_API_KEY=
